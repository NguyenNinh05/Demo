@startuml seq-voice
!include _style.iuml
autonumber
hide footbox

actor Customer
boundary SearchUI
boundary VoiceInput
control SpeechService
control SearchService
control QueryService
control RuleParser
participant ProductRepository
participant TextIndex
control RankingService

Customer -> SearchUI : nói "cho tui coi quần đùi hông quá 300 ngàn"
activate SearchUI
SearchUI -> VoiceInput : capture(source)
activate VoiceInput
VoiceInput --> SearchUI : audio
deactivate VoiceInput
SearchUI -> SpeechService : transcribe(audio)
activate SpeechService

alt không nhận dạng được giọng nói
  SpeechService --> SearchUI : lỗi
  SearchUI --> Customer : "Không nhận dạng được giọng nói"
else nhận dạng thành công
  SpeechService --> SearchUI : text
  deactivate SpeechService
  SearchUI -> SearchService : search(text, modality = "voice")
  activate SearchService
  SearchService -> QueryService : voice_query(text)
  activate QueryService
  QueryService -> RuleParser : parse(text)
  activate RuleParser
  RuleParser --> QueryService : hông → không, quần đùi, giá ≤ 300.000
  deactivate RuleParser
  QueryService --> SearchService : query
  deactivate QueryService
  SearchService -> ProductRepository : find(điều kiện, fuzzy_terms)
  activate ProductRepository
  ProductRepository --> SearchService : ứng viên
  deactivate ProductRepository
  SearchService -> TextIndex : score(từ khóa, ứng viên)
  activate TextIndex
  TextIndex --> SearchService : điểm BM25
  deactivate TextIndex
  SearchService -> RankingService : rank(candidates, query, top_k)
  activate RankingService
  RankingService --> SearchService : Top-K, (α, β, γ)
  deactivate RankingService
  SearchService --> SearchUI : response
  deactivate SearchService
  SearchUI --> Customer : hiển thị kết quả
end
deactivate SearchUI
@enduml
