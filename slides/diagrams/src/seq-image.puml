@startuml seq-image
!include _style.iuml
autonumber
hide footbox

actor Customer
boundary SearchUI
boundary ImageUpload
control ImageService
control SearchService
control QueryService
participant VectorIndex
participant ProductRepository
control RankingService

Customer -> SearchUI : image_search(image_path)
activate SearchUI
SearchUI -> ImageUpload : upload(path)
activate ImageUpload

alt ảnh không tồn tại, sai định dạng hoặc lớn hơn 10 MB
  ImageUpload --> SearchUI : lỗi
  SearchUI --> Customer : "Ảnh không hợp lệ"
else ảnh hợp lệ
  ImageUpload --> SearchUI : path
  deactivate ImageUpload
  SearchUI -> ImageService : encode(path)
  activate ImageService
  ImageService -> ImageService : preprocess(image)
  ImageService --> SearchUI : embedding
  deactivate ImageService
  SearchUI -> SearchService : search(modality = "image", embedding, image)
  activate SearchService
  SearchService -> QueryService : image_query(embedding, image)
  activate QueryService
  QueryService --> SearchService : query
  deactivate QueryService
  SearchService -> VectorIndex : scores(embedding)
  activate VectorIndex
  VectorIndex --> SearchService : độ tương đồng cosine
  deactivate VectorIndex
  loop mỗi ứng viên gần nhất
    SearchService -> ProductRepository : get_product(id)
    activate ProductRepository
    ProductRepository --> SearchService : product
    deactivate ProductRepository
  end
  SearchService -> RankingService : rank(candidates, query, top_k)
  activate RankingService
  RankingService --> SearchService : Top-K, (α, β, γ)
  deactivate RankingService
  SearchService --> SearchUI : response
  deactivate SearchService
  SearchUI --> Customer : hiển thị sản phẩm giống ảnh
end
deactivate SearchUI
@enduml
