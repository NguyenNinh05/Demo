# Copy this file to .env and fill in the values.

# PostgreSQL (local socket, current macOS user, no password)
DATABASE_URL=postgresql://localhost:5432/snapshop

# Gemini (free key: https://aistudio.google.com/apikey)
# Without a key the shop still works: rule parser for text, browser speech recognition for voice.
GEMINI_API_KEY=
# comma-separated: fallback models are used when the first one is overloaded (503) or out of quota (429)
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_STT_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
GEMINI_TIMEOUT=10

# DeepSeek - LLM for hard queries ("quà cho bạn trai"); used instead of Gemini when set
# (https://platform.deepseek.com, thinking mode is turned off by the code for speed)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Soniox real-time speech-to-text (https://console.soniox.com) - replaces Gemini for voice
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5

# models (downloaded from Hugging Face on first run)
PHOTO_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
CLIP_IMAGE_MODEL=clip-ViT-B-32
CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1

# the logged-in customer of the demo
CURRENT_CUSTOMER=C001
